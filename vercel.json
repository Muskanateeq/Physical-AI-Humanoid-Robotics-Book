{
  "buildCommand": "cd physical-ai-humanoid-robotics && npm run build",
  "outputDirectory": "physical-ai-humanoid-robotics/build",
  "installCommand": "cd physical-ai-humanoid-robotics && npm install",
  "framework": "docusaurus-2",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/physical-ai-humanoid-robotics/$1"
    }
  ]
}
